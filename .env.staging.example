# IlmLiga staging muhiti uchun SECRET-SIZ namuna.
# Staging serverda ushbu faylni `.env` nomi bilan nusxalang.
# Hech qachon production credential yoki production database ishlatmang.

# --- Server ---
PORT=3100
# Staging internetga ochilishi mumkin: production security guardlar yoqilgan qoladi.
NODE_ENV=production
TRUST_PROXY_HOPS=1
CLIENT_ORIGIN=https://staging.example.com

# --- Alohida staging PostgreSQL ---
DB_USER=eb_staging_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=english_battle_staging
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STARTUP_TIMEOUT_MS=5000

# --- Authentication ---
# Har bir secret alohida bo'lsin: JWT/pepperlar kamida 32 belgi.
JWT_SECRET=
JWT_EXPIRES_IN=30d
PARENT_CODE_PEPPER=
SCHOOL_INVITE_PEPPER=

# --- Staging admin ---
# Parol kamida 12 belgi; TOTP secret kamida 16 belgili Base32.
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=

# --- Alohida test provider credentiallari ---
# Production guardlar sabab staging uchun ham qiymatlar majburiy.
# Faqat staging/test accountlardan foydalaning.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=

# --- AI stagingda default o'chiq ---
AI_REPORTS_ENABLED=false
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
