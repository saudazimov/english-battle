# ============================================================
# English Battle — .env namunasi
# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env HECH QACHON git'ga qo'shilmasin!
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development            # production serverda: production
# Reverse proxy yo'q bo'lsa 0. Nginx bitta hop bo'lsa 1.
TRUST_PROXY_HOPS=0

# --- CORS ---
# Developmentda frontend shu serverdan xizmat qilinsa bo'sh qolishi mumkin.
# Productionda kamida bitta haqiqiy HTTPS origin majburiy; vergul bilan ro'yxat:
# CLIENT_ORIGIN=https://ilmliga.uz,https://www.ilmliga.uz
CLIENT_ORIGIN=

# --- Private metrics ---
# Faqat local monitoring collector ishlatadi. Productionda kamida 32 belgi.
# Generatsiya: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
METRICS_TOKEN=

# --- Shifrlangan off-site backup ---
# Rclone ichida `crypt` turida sozlangan, alohida production path bo'lishi shart.
OFFSITE_BACKUP_REMOTE=
OFFSITE_BACKUP_LOCAL_DIR=/var/backups/ilm-liga/offsite
OFFSITE_BACKUP_RETENTION_DAYS=14
# RCLONE_BIN=/usr/bin/rclone

# --- PostgreSQL ---
DB_USER=postgres
# Productionda kamida 12 belgili, boshqa secretlardan farqli qiymat ishlating.
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=english_battle
# Local PostgreSQL uchun false. Remote managed DB uchun true.
DB_SSL=false
# Pool va production startup timeoutlari (millisekundlarda).
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STARTUP_TIMEOUT_MS=5000

# --- JWT ---
# Eski ochiq registratsiya kodi saqlanadi, lekin admin orqali akkaunt yaratish davrida yopiq turadi.
PUBLIC_REGISTRATION_ENABLED=false
# Productionda kamida 32 belgi. Tasodifiy satr yarating:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# --- Parent connect-code hashing (child safety) ---
# Ota-ona ulanish kodini hashlash uchun maxfiy "pepper".
# Developmentda bo'sh qolsa JWT_SECRET ishlatiladi.
# Productionda ikkala pepper ham majburiy, kamida 32 belgi va bir-biridan farqli.
# Generatsiya: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PARENT_CODE_PEPPER=
# School-admin invite kodlari uchun alohida pepper.
SCHOOL_INVITE_PEPPER=

# --- Admin ---
# ADMIN_PASSWORD kamida 12 belgi; ADMIN_TOTP_SECRET kamida 16 belgili Base32.
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=

# --- SMS (Eskiz.uz) — bo'sh qolsa DEV rejim: kod terminalga chiqadi ---
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# --- To'lov (Payme) — kalit kelganda to'ldiriladi ---
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=

# --- AI hisobotlar (ixtiyoriy) ---
AI_REPORTS_ENABLED=false
AI_QUESTION_ANALYSIS_ENABLED=true
AI_PROVIDER=anthropic           # anthropic | openai
AI_REQUEST_TIMEOUT_MS=30000
AI_PROVIDER_RETRIES=2
AI_RETRY_BASE_MS=500
AI_MAX_OUTPUT_TOKENS=4000
# Ixtiyoriy: primary model ishlamasa shu model sinab ko'riladi.
AI_FALLBACK_MODEL=
# Provider narxiga mos USD / 1M token kiriting; 0 bo'lsa faqat tokenlar loglanadi.
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
# 0 = hard-limit o'chirilgan. Productionda provider narxlari bilan birga musbat qiymat qo'ying.
AI_MONTHLY_HARD_LIMIT_USD=0
# Jarayon uzilib qolsa, tugallanmagan xarajat rezervatsiyasi necha daqiqada tozalanadi.
AI_BUDGET_RESERVATION_TTL_MINUTES=15
# Boshqa instance ayni kontentni yaratayotganda cache natijasini kutish chegaralari.
AI_CONTENT_CACHE_WAIT_MS=30000
AI_CONTENT_CACHE_POLL_MS=250
# Rule signature backfill faqat operator --execute berganda ishlaydi; 0 = CLI'da alohida limit majburiy.
AI_RULE_SIGNATURE_BACKFILL_MAX_COST_USD=0
# Har savol uchun ikki bosqichli tahlilning konservativ token bahosi.
AI_RULE_SIGNATURE_BACKFILL_INPUT_TOKENS=12000
AI_RULE_SIGNATURE_BACKFILL_OUTPUT_TOKENS=3300
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_FALLBACK_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_FALLBACK_MODEL=

# --- Automated E2E (ixtiyoriy) ---
# Tashqi test server ishlatilsa oching:
# E2E_BASE_URL=http://127.0.0.1:3000
