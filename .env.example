# ============================================================
# English Battle — .env namunasi
# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env HECH QACHON git'ga qo'shilmasin!
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development            # production serverda: production

# --- CORS ---
# Frontend shu serverdan xizmat qilinsa BO'SH qoldiring (CORS kerak emas).
# Alohida domen/mobil ilova bo'lsa, vergul bilan ro'yxat:
# CLIENT_ORIGIN=https://englishbattle.uz,https://app.englishbattle.uz
CLIENT_ORIGIN=

# --- PostgreSQL ---
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=english_battle

# --- JWT ---
# Uzun tasodifiy satr yarating: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# --- Parent connect-code hashing (child safety) ---
# Ota-ona ulanish kodini hashlash uchun maxfiy "pepper".
# Bo'sh qolsa JWT_SECRET ishlatiladi (baribir xavfsiz), lekin alohida qiymat afzal.
# Generatsiya: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PARENT_CODE_PEPPER=

# --- Admin ---
ADMIN_PASSWORD=

# --- SMS (Eskiz.uz) — bo'sh qolsa DEV rejim: kod terminalga chiqadi ---
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# --- To'lov (Payme) — kalit kelganda to'ldiriladi ---
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=

# --- AI hisobotlar (ixtiyoriy) ---
AI_REPORTS_ENABLED=false
AI_PROVIDER=anthropic           # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=